# SafeCall local configuration template. No credentials are included.
# Store actual Meta API credentials OUTSIDE this repository and load them into the SERVER process.

# Safe defaults: local scripted TTS + rules, no external AI calls.
META_LIVE_ENABLED=false
META_VOICE_LIVE_ENABLED=false
SAFECALL_MEDIA_ASR_ENABLED=false
META_SPEND_APPROVED=false
META_BUDGET_KILL_SWITCH=true
META_MAX_REQUESTS_PER_RUN=4

# When you have a valid Meta Model API key, budget approval, synthetic audio transfer consent
# and confirmed access to Muse Spark and Muse Voice Transcribe, configure a private env file:
# MODEL_API_KEY=<set privately; NEVER commit>
# META_LIVE_ENABLED=true
# SAFECALL_MEDIA_ASR_ENABLED=true
# META_SPEND_APPROVED=true
# META_BUDGET_KILL_SWITCH=false
# SAFECALL_MEDIA_ASR_LANGUAGES=English
# SAFECALL_LIVE_VERIFY_CONSENT=YES
# SAFECALL_FFMPEG_PATH=/path/to/ffmpeg

# Legacy third-party recording authorization is intentionally empty.
# All included media are synthetic TTS WAV recordings; no original voice-phishing MP4 files.
SAFECALL_MEDIA_EXTERNAL_AUTHORIZED=
